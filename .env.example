# api_embed: copia este fichero como .env en el directorio de la aplicacion,
# con permisos 600 y del usuario que ejecuta el servicio. .env no va a git.
#
# Clave de la API (cabecera X-API-Key). OBLIGATORIA: sin ella la aplicacion
# no arranca. Usa una clave larga y aleatoria (32 caracteres o mas).
EMBED_API_KEY=
#
# Carpeta del registro de la aplicacion (api_embed.log, 50 MB x 3).
# Vacia o sin definir: el registro va solo a la salida estandar.
EMBED_LOG_DIR=
#
# Prefijo cuando va detras de un proxy (por ejemplo /embed). Opcional.
ROOT_PATH=
